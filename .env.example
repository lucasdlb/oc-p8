# Shared (read by docker-compose for variable substitution)
LOG_LEVEL=INFO
LOG_PATH=logs/app.log
ENV=dev
API_PORT=8000
METRICS_PORT=9100
DATA_PATH=data

# API service (also reads .env.api)
# MODEL_PATH=artifacts/inference_pipeline_debug.pkl
# API_HOST=0.0.0.0
# DATA_SOURCE=csv  # uncomment to enable /predict; omit to disable

# Drift monitoring (Evidently UI)
# DRIFT_ENABLED=true
# DRIFT_REFERENCE_PATH=data/reference
# DRIFT_WORKSPACE_PATH=workspace
# DRIFT_INTERVAL=60
# DRIFT_BUFFER_SIZE=5000
# DRIFT_MIN_SAMPLES=50
# DRIFT_PSI_THRESHOLD=0.25
